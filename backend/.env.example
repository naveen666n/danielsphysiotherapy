NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://localhost:5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=physio_clinic

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

PAYMENT_MODE=test
PAYMENT_GATEWAY=razorpay

RAZORPAY_KEY_ID_TEST=
RAZORPAY_KEY_SECRET_TEST=
RAZORPAY_KEY_ID_LIVE=
RAZORPAY_KEY_SECRET_LIVE=

# Gmail SMTP account used to send appointment notification emails.
# SMTP_APP_PASSWORD must be a Gmail "App Password", not the account password.
SMTP_USER_NAME=
SMTP_APP_PASSWORD=
# Comma-separated list of addresses to CC on every appointment notification email.
CC_EMAILS=
